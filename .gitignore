# Build artifacts (everything intermediate now lands under build/)
/build/

# Compiled outputs anywhere in the tree
*.o
*.elf
*.bin

# Disk images (all generated by the Makefile / mkfs)
*.img

# Local vector sources used to generate the PAM assets packed by EmbLinkOS.
# The runtime cannot decode SVG; only the generated system/images/pam/*.pam
# files belong in the repository and in embkfs.img.
/system/images/svg/

# QEMU / debug logs
*.log

# Python tooling caches
__pycache__/
*.pyc

# clangd index database -- machine-specific absolute paths; regenerate with
# `make compile-commands` (tools/gen_compile_commands.py)
/compile_commands.json
/.cache/

# Personal Claude Code settings (machine-specific paths / permissions)
.claude/settings.json
.claude/settings.local.json
